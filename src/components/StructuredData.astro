---
import { CF_IMAGES, SALES_EMAIL, SITE } from '../lib/site';

const website = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE.url}#website`,
	name: SITE.name,
	url: SITE.url,
	description: SITE.description,
	inLanguage: 'en-US',
};

const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': SITE.url,
	name: `${SITE.name} • Premium Domain For Acquisition`,
	url: SITE.url,
	description: SITE.description,
	inLanguage: 'en-US',
	isPartOf: { '@id': `${SITE.url}#website` },
	about: {
		'@type': 'Thing',
		name: SITE.name,
		description: SITE.description,
	},
	mainEntity: {
		'@type': 'Offer',
		name: `${SITE.name} domain name`,
		url: SITE.url,
		priceCurrency: 'USD',
		availability: 'https://schema.org/InStock',
		seller: {
			'@type': 'Organization',
			name: 'Desert Rich',
			email: SALES_EMAIL,
		},
		itemOffered: {
			'@type': 'Thing',
			name: SITE.name,
			description: SITE.description,
			image: CF_IMAGES.hero,
			category: 'Premium Domain Name',
		},
	},
};

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${SITE.url}#organization`,
	name: SITE.name,
	url: SITE.url,
	logo: CF_IMAGES.hero,
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'domain acquisition',
		email: SALES_EMAIL,
		availableLanguage: 'English',
	},
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
