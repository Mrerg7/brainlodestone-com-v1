---
import { getCollection } from 'astro:content';
import { CF_IMAGES, PRICE, SALES_EMAIL, SITE } from '../lib/site';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);

const website = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE.url}#website`,
	name: SITE.name,
	url: SITE.url,
	description: SITE.description,
	inLanguage: 'en-US',
};

const webPage = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': SITE.url,
	name: SITE.title,
	url: SITE.url,
	description: SITE.description,
	inLanguage: 'en-US',
	isPartOf: { '@id': `${SITE.url}#website` },
	about: {
		'@type': 'Thing',
		name: SITE.name,
		description: SITE.description,
	},
	mainEntity: {
		'@type': 'Offer',
		name: `${SITE.name} domain name`,
		url: SITE.url,
		price: String(PRICE.amount),
		priceCurrency: PRICE.currency,
		availability: 'https://schema.org/InStock',
		itemOffered: {
			'@type': 'Thing',
			name: SITE.name,
			description: SITE.description,
			image: CF_IMAGES.hero,
			category: 'Premium Domain Name',
		},
		seller: {
			'@type': 'Organization',
			name: 'Desert Rich',
			email: SALES_EMAIL,
		},
	},
};

const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${SITE.url}#organization`,
	name: SITE.name,
	url: SITE.url,
			logo: CF_IMAGES.hero,
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'domain acquisition',
		email: SALES_EMAIL,
		availableLanguage: 'English',
	},
};

const faqPage = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${SITE.url}#faq`,
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.data.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.data.answer,
		},
	})),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(webPage)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
{
	faqs.length > 0 && (
		<script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
	)
}
