---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Brandmark from '../components/Brandmark.astro';
import FieldMotif from '../components/FieldMotif.astro';
import { getCollection } from 'astro:content';
import { CF_IMAGES, PRICE, SALES_EMAIL } from '../lib/site';

const marketStats = (await getCollection('marketStats')).sort(
	(a, b) => a.data.order - b.data.order,
);
const useCases = (await getCollection('useCases')).sort(
	(a, b) => a.data.order - b.data.order,
);
const valuePillars = (await getCollection('valuePillars')).sort(
	(a, b) => a.data.order - b.data.order,
);
const faqs = (await getCollection('faqs')).sort(
	(a, b) => a.data.order - b.data.order,
);

const steps = [
	{
		title: 'Send an inquiry',
		body: `Tell us your intended use and timeline. We reply within 24 hours with confirmation that ${PRICE.display} is still available and the exact next step.`,
	},
	{
		title: 'Fund escrow',
		body: 'Escrow.com opens a secure transaction. Your payment is held by a licensed third party — the seller cannot touch it, and you are not exposed.',
	},
	{
		title: 'Take ownership',
		body: 'We unlock the domain and release the auth code. Once it lands in your registrar and you confirm control, escrow releases the funds. Typically 5–7 days.',
	},
];

const iconMap = {
	magnet: 'magnet',
	search: 'search',
	globe: 'globe',
	handshake: 'handshake',
	shield: 'shield',
	rocket: 'rocket',
} as const;
---

<BaseLayout>
	<Nav />
	<main>
		<Hero />

		<!-- TRUST / MARKET STATS BAR -->
		<div class="border-b border-ink-800 bg-ink-900/60">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-6">
				<div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 gap-x-4 text-center md:text-left">
					{
						marketStats.map((stat) => (
							<div>
								<div class="font-mono text-3xl font-semibold text-brass-400 stat-number">{stat.data.value}</div>
								<div class="text-xs uppercase tracking-widest text-ink-400 mt-1">{stat.data.label}</div>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<!-- THE OPPORTUNITY -->
		<section id="opportunity" class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 pt-20 pb-16">
			<div class="max-w-3xl mb-12">
				<div class="uppercase text-brass-400 text-xs font-semibold tracking-[2px] mb-3">THE MARKET MOMENT</div>
				<h2 class="text-4xl md:text-5xl font-editorial tracking-tight">A once-in-a-generation opportunity in brain health.</h2>
				<p class="mt-5 text-xl text-ink-300">Major depressive disorder affects over 21 million U.S. adults annually. For the significant portion who do not respond to medication or therapy, TMS offers new hope — and explosive demand for trusted brands.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-6">
				<div class="glass rounded-2xl p-8 benefit-card">
					<div class="w-11 h-11 rounded-2xl bg-brass-400/10 flex items-center justify-center mb-6">
						<Icon name="chart-line" class="w-7 h-7 text-brass-400" />
					</div>
					<h3 class="font-semibold text-xl tracking-tight mb-3">Explosive Category Growth</h3>
					<p class="text-ink-300 text-[15px]">The TMS systems and services market is projected to reach $2–4 billion by the early 2030s. Clinics, device manufacturers, and digital platforms are scaling rapidly across North America and globally.</p>
				</div>

				<div class="glass rounded-2xl p-8 benefit-card">
					<div class="w-11 h-11 rounded-2xl bg-brass-400/10 flex items-center justify-center mb-6">
						<Icon name="shield" class="w-7 h-7 text-brass-400" />
					</div>
					<h3 class="font-semibold text-xl tracking-tight mb-3">Proven Clinical Outcomes</h3>
					<p class="text-ink-300 text-[15px]">FDA-cleared for major depression, OCD, migraines, and smoking cessation. Real-world response rates of 50–65% and remission rates of 30–40% in patients who failed multiple prior treatments.</p>
				</div>

				<div class="glass rounded-2xl p-8 benefit-card">
					<div class="w-11 h-11 rounded-2xl bg-brass-400/10 flex items-center justify-center mb-6">
						<Icon name="globe" class="w-7 h-7 text-brass-400" />
					</div>
					<h3 class="font-semibold text-xl tracking-tight mb-3">Brand-Ready Territory</h3>
					<p class="text-ink-300 text-[15px]">Most TMS providers still operate under generic or clinical names. brainlodestone.com delivers instant differentiation, memorability, and SEO alignment in a high-intent category.</p>
				</div>
			</div>
		</section>

		<!-- THE SCIENCE -->
		<section id="science" class="bg-ink-900 border-y border-ink-800">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-20">
				<div class="grid lg:grid-cols-12 gap-x-12 gap-y-10 items-center">
					<div class="lg:col-span-7">
						<div class="uppercase text-brass-400 text-xs font-semibold tracking-[2px] mb-3">GROUNDED IN CLINICAL EVIDENCE</div>
						<h2 class="text-4xl md:text-5xl font-editorial tracking-tight mb-6">Non-invasive. Precise. Life-changing.</h2>

						<div class="space-y-6 text-[15.2px] text-ink-300">
							<p>Transcranial magnetic stimulation (TMS) uses targeted magnetic fields to stimulate nerve cells in brain regions involved in mood regulation. It is FDA-approved and typically recommended when standard treatments such as medication and psychotherapy have not been effective.</p>

							<div class="grid sm:grid-cols-2 gap-4 pt-2">
								<div class="flex gap-3">
									<Icon name="check" class="w-5 h-5 text-brass-400 shrink-0 mt-0.5" />
									<div><span class="font-medium text-white">No surgery. No anesthesia.</span><br /><span class="text-sm">Outpatient procedure performed in a clinic.</span></div>
								</div>
								<div class="flex gap-3">
									<Icon name="check" class="w-5 h-5 text-brass-400 shrink-0 mt-0.5" />
									<div><span class="font-medium text-white">Minimal side effects.</span><br /><span class="text-sm">Most common: mild scalp discomfort or headache that improves quickly.</span></div>
								</div>
								<div class="flex gap-3">
									<Icon name="check" class="w-5 h-5 text-brass-400 shrink-0 mt-0.5" />
									<div><span class="font-medium text-white">FDA-cleared indications.</span><br /><span class="text-sm">Major depression, OCD, migraines, and smoking cessation.</span></div>
								</div>
								<div class="flex gap-3">
									<Icon name="check" class="w-5 h-5 text-brass-400 shrink-0 mt-0.5" />
									<div><span class="font-medium text-white">Growing research pipeline.</span><br /><span class="text-sm">Ongoing studies for epilepsy, anxiety, PTSD, and more.</span></div>
								</div>
							</div>
						</div>

						<a href="#contact" class="mt-8 inline-flex items-center text-sm text-brass-400 hover:text-brass-300 transition-colors">
							<span class="font-medium">Own the brand that patients and referrers will remember</span>
							<Icon name="arrow-right" class="w-4 h-4 ml-2" />
						</a>
					</div>

					<div class="lg:col-span-5 relative">
						<div class="rounded-2xl overflow-hidden border border-ink-700 shadow-2xl">
							<img
								src={CF_IMAGES.science}
								alt="Patient receiving TMS therapy in a modern clinical setting"
								class="w-full h-auto object-cover"
								width={800}
								height={600}
								loading="lazy"
							/>
						</div>
						<div class="absolute -bottom-4 -left-4 bg-ink-900 border border-ink-700 rounded-2xl px-5 py-3 text-xs shadow-xl max-w-[210px]">
							<div class="font-medium text-white">"TMS is one of the fastest growing treatment techniques in mental health."</div>
							<div class="text-brass-400 text-[10px] mt-1">— Clinical TMS Society & leading providers</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- WHY THIS DOMAIN -->
		<section id="why" class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-20">
			<div class="max-w-2xl mb-12">
				<div class="text-brass-400 text-xs font-semibold tracking-[2px]">THE STRATEGIC ADVANTAGE</div>
				<h2 class="text-4xl md:text-5xl font-editorial tracking-tight mt-2">Why brainlodestone.com is a lodestone for success.</h2>
				<p class="mt-4 text-lg text-ink-300">"Lodestone" is not just poetic — it literally describes a naturally magnetic stone. In a category defined by magnetic pulses and attracting better patient outcomes, this name is powerfully on-brand.</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
				{
					valuePillars.map((pillar) => (
						<div class="benefit-card border border-ink-800 rounded-2xl p-8 hover:border-brass-900/60 transition-colors">
							<div class="flex items-center gap-x-3 mb-5">
								<div class="text-brass-400">
									<Icon name={iconMap[pillar.data.icon]} class="w-8 h-8" />
								</div>
								<div class="font-semibold text-xl tracking-tight">{pillar.data.title}</div>
							</div>
							<p class="text-ink-300">{pillar.data.description}</p>
						</div>
					))
				}
			</div>
		</section>

		<!-- PERFECT FOR / USE CASES -->
		<section id="perfect-for" class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 pb-20">
			<div class="text-center mb-12">
				<div class="text-brass-400 text-xs font-semibold tracking-[2px]">IDEAL BRAND FIT</div>
				<h2 class="text-4xl md:text-5xl font-editorial tracking-tight mt-2">Built for category leaders.</h2>
			</div>

			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
				{
					useCases.map((item) => (
						<div class="group rounded-2xl border border-ink-800 p-7 hover:border-brass-900/50 transition-all">
							<div class="mb-4 text-brass-400">
								<Icon name={iconMap[item.data.icon]} class="w-8 h-8" />
							</div>
							<div class="font-semibold text-lg mb-1.5">{item.data.title}</div>
							<p class="text-sm text-ink-400">{item.data.description}</p>
						</div>
					))
				}
			</div>

			<div class="mt-8 text-center">
				<p class="text-sm text-ink-400 max-w-md mx-auto">The name works across B2B and B2C — from institutional partnerships to direct-to-patient marketing.</p>
			</div>
		</section>

		<!-- BRAND VISUAL -->
		<section class="border-y border-ink-800 bg-ink-900 py-16">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16">
				<div class="grid lg:grid-cols-12 gap-x-12 items-center">
					<div class="lg:col-span-5 mb-10 lg:mb-0">
						<div class="uppercase text-xs tracking-[2px] text-brass-400 font-semibold mb-3">INSTANT BRAND EQUITY</div>
						<h3 class="font-editorial text-4xl tracking-tight leading-none">See the brand<br />come to life.</h3>
						<p class="mt-5 text-ink-300">brainlodestone.com delivers a complete, ownable visual and verbal identity from day one. Clean, modern, and unmistakably relevant.</p>

						<div class="mt-8 flex flex-wrap gap-3">
							<div class="px-4 py-1.5 rounded-full bg-ink-800 text-xs font-medium flex items-center gap-x-2">
								<Icon name="check" class="w-4 h-4 text-brass-400" />
								<span>Tagline: Guiding the mind</span>
							</div>
							<div class="px-4 py-1.5 rounded-full bg-ink-800 text-xs font-medium flex items-center gap-x-2">
								<Icon name="check" class="w-4 h-4 text-brass-400" />
								<span>Graphite, brass &amp; steel palette</span>
							</div>
						</div>
					</div>

					<div class="lg:col-span-7">
						<div class="relative rounded-2xl overflow-hidden border border-ink-700 bg-gradient-to-br from-ink-900 via-ink-950 to-ink-900 px-6 py-14 sm:px-10 md:px-14 md:py-16 text-center">
							<div
								class="pointer-events-none absolute inset-0 opacity-[0.06]"
								aria-hidden="true"
								style="background-image: repeating-linear-gradient(0deg, transparent 0 23px, #f5a94e 23px 24px), repeating-linear-gradient(90deg, transparent 0 23px, #f5a94e 23px 24px);"
							></div>

							<div class="relative flex flex-col items-center gap-5">
								<Brandmark class="h-16 w-16 md:h-20 md:w-20 text-brass-400" />
								<div class="font-display text-[1.7rem] sm:text-4xl md:text-5xl tracking-tight text-white [overflow-wrap:anywhere]">
									brain<span class="text-brass-400">lodestone</span><span class="align-super font-mono text-xs sm:text-sm text-brass-400/70">.com</span>
								</div>
								<div class="h-px w-40 bg-gradient-to-r from-transparent via-ink-600 to-transparent"></div>
								<div class="text-[11px] uppercase tracking-[0.5em] text-brass-300/80">Guiding the mind</div>
								<div class="mt-1 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.2em] text-ink-500">
									<span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm border border-ink-600 bg-ink-800"></span>Graphite</span>
									<span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-brass-400"></span>Brass</span>
									<span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-steel-400"></span>Steel</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- HOW TO ACQUIRE -->
		<section id="how-it-works" class="bg-ink-900 border-y border-ink-800">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-20">
				<div class="max-w-2xl mb-12">
					<div class="text-brass-400 text-xs font-semibold tracking-[2px]">HOW TO ACQUIRE</div>
					<h2 class="text-4xl md:text-5xl font-editorial tracking-tight mt-2">Three steps. No brokers, no auctions.</h2>
					<p class="mt-4 text-lg text-ink-300">
						<strong class="text-white">List price: {PRICE.display} USD.</strong>
						You deal directly with the owner, every dollar moves through escrow, and you never
						lose control of your funds or the domain mid-transfer.
					</p>
				</div>

				<ol class="grid md:grid-cols-3 gap-6">
					{
						steps.map((step, index) => (
							<li class="glass rounded-2xl p-8 benefit-card">
								<div class="mb-6 flex h-11 w-11 items-center justify-center rounded-2xl bg-brass-400 font-display text-lg font-semibold text-ink-950">
									{index + 1}
								</div>
								<h3 class="font-semibold text-xl tracking-tight mb-3">{step.title}</h3>
								<p class="text-ink-300 text-[15px]">{step.body}</p>
							</li>
						))
					}
				</ol>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-400">
					<span class="flex items-center gap-x-2"><Icon name="lock" class="w-4 h-4 text-brass-400" /> Escrow.com protected</span>
					<span class="flex items-center gap-x-2"><Icon name="check" class="w-4 h-4 text-brass-400" /> Flexible payment terms</span>
					<span class="flex items-center gap-x-2"><Icon name="check" class="w-4 h-4 text-brass-400" /> Confidential, direct-with-owner</span>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section id="faq" class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-20">
			<div class="grid gap-x-12 gap-y-10 lg:grid-cols-12">
				<div class="lg:col-span-4">
					<div class="text-brass-400 text-xs font-semibold tracking-[2px]">BUYER FAQ</div>
					<h2 class="mt-2 text-4xl md:text-5xl font-editorial tracking-tight">Questions, answered.</h2>
					<p class="mt-4 text-ink-300">
						Everything serious buyers ask before wiring six figures for a domain name. Still
						unsure? Email
						<a href={`mailto:${SALES_EMAIL}`} class="text-brass-400 hover:text-brass-300 underline underline-offset-4">{SALES_EMAIL}</a>.
					</p>
				</div>

				<div class="lg:col-span-8">
					<div class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
						{
							faqs.map((faq, index) => (
								<div class="border-t border-ink-800 pt-5">
									<div class="mb-2 font-mono text-[11px] tracking-[0.2em] text-brass-400/70">
										Q{String(index + 1).padStart(2, '0')}
									</div>
									<h3 class="font-editorial text-xl leading-snug text-white">
										{faq.data.question}
									</h3>
									<p class="mt-2.5 text-[15px] leading-relaxed text-ink-300">
										{faq.data.answer}
									</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ACQUIRE / LEAD FORM -->
		<section id="acquire" class="relative overflow-hidden max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 py-20">
			<FieldMotif class="pointer-events-none absolute left-1/2 top-1/2 h-[48rem] w-[48rem] max-w-none -translate-x-1/2 -translate-y-1/2 text-brass-300 opacity-[0.13]" />

			<div class="relative max-w-2xl mx-auto text-center mb-10">
				<div class="inline-block px-4 py-1 rounded-full bg-brass-400/10 text-brass-400 text-xs font-semibold tracking-widest mb-4">SECURE YOUR POSITION</div>
				<h2 class="text-4xl md:text-5xl font-editorial tracking-tight">Ready to own brainlodestone.com?</h2>
				<p class="mt-4 text-lg text-ink-300">
					List price <strong class="text-white font-semibold">{PRICE.display} USD</strong>.
					Flexible payment options and a seamless escrow-protected transfer — we reply to every
					serious inquiry within 24 hours.
				</p>
			</div>

			<div class="relative max-w-[620px] mx-auto">
				<div class="glass rounded-2xl p-8 md:p-10 border border-ink-700">
					<form id="inquiry-form" class="space-y-5">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
							<div>
								<label class="block text-xs font-medium tracking-wider text-ink-400 mb-1.5" for="full-name">FULL NAME</label>
								<input type="text" id="full-name" name="name" required autocomplete="name" maxlength="120"
									class="w-full bg-ink-900 border border-ink-700 focus:border-brass-500 rounded-2xl px-5 py-3.5 text-sm placeholder:text-ink-500 outline-none transition-colors text-white" />
							</div>
							<div>
								<label class="block text-xs font-medium tracking-wider text-ink-400 mb-1.5" for="email">EMAIL ADDRESS</label>
								<input type="email" id="email" name="email" required autocomplete="email" maxlength="254"
									class="w-full bg-ink-900 border border-ink-700 focus:border-brass-500 rounded-2xl px-5 py-3.5 text-sm placeholder:text-ink-500 outline-none transition-colors text-white" />
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
							<div>
								<label class="block text-xs font-medium tracking-wider text-ink-400 mb-1.5" for="phone">PHONE (OPTIONAL)</label>
								<input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40"
									class="w-full bg-ink-900 border border-ink-700 focus:border-brass-500 rounded-2xl px-5 py-3.5 text-sm placeholder:text-ink-500 outline-none transition-colors text-white" />
							</div>
							<div>
								<label class="block text-xs font-medium tracking-wider text-ink-400 mb-1.5" for="intended-use">INTENDED USE</label>
								<select id="intended-use" name="use" required
									class="w-full bg-ink-900 border border-ink-700 focus:border-brass-500 rounded-2xl px-5 py-3.5 text-sm text-white outline-none transition-colors">
									<option value="">Select category...</option>
									<option value="TMS / Mental Health Clinic">TMS / Mental Health Clinic Network</option>
									<option value="Neurotechnology / Device Company">Neurotechnology or Medical Device Company</option>
									<option value="Digital Health Platform">Digital Health or Telehealth Platform</option>
									<option value="Research / Academic / Nonprofit">Research, Academic, or Nonprofit</option>
									<option value="Investment / Domain Portfolio">Investment or Domain Portfolio</option>
									<option value="Other">Other / Not Disclosed</option>
								</select>
							</div>
						</div>

						<div>
							<label class="block text-xs font-medium tracking-wider text-ink-400 mb-1.5" for="message">MESSAGE OR QUESTIONS</label>
							<textarea id="message" name="message" rows="3" maxlength="4000" placeholder="Tell us about your vision for brainlodestone.com..."
								class="w-full resize-y bg-ink-900 border border-ink-700 focus:border-brass-500 rounded-2xl px-5 py-4 text-sm placeholder:text-ink-500 outline-none transition-colors text-white"></textarea>
						</div>

						<!-- Honeypot: hidden from humans, attractive to bots. -->
						<div class="hidden" aria-hidden="true">
							<label for="website">Website</label>
							<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
						</div>

						<p id="form-error" role="alert" aria-live="polite"
							class="hidden rounded-2xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-200"></p>

						<button type="submit"
							class="w-full mt-2 flex items-center justify-center gap-x-3 bg-white hover:bg-ink-100 active:bg-ink-200 transition-all text-ink-900 font-semibold text-base py-4 rounded-2xl shadow-inner">
							<span>Submit Inquiry</span>
							<Icon name="mail" class="w-5 h-5" />
						</button>

						<p class="text-center text-xs text-ink-500 pt-1">
							Strictly confidential • We respond within 24 hours •
							<a href={`mailto:${SALES_EMAIL}`} class="text-brass-400 hover:text-brass-300 underline underline-offset-4">or email us directly</a>
						</p>
					</form>

					<!-- Success State -->
					<div id="form-success" class="hidden text-center py-8">
						<div class="mx-auto w-16 h-16 rounded-full bg-brass-400/10 flex items-center justify-center mb-6">
							<Icon name="check" class="w-10 h-10 text-brass-400" />
						</div>
						<h4 class="font-semibold text-2xl tracking-tight">Thank you. Your inquiry has been received.</h4>
						<p class="mt-3 text-ink-300 max-w-xs mx-auto">A member of our acquisitions team will contact you within 24 hours to discuss next steps, pricing, and secure transfer options.</p>
						<a href={`mailto:${SALES_EMAIL}?subject=${encodeURIComponent('brainlodestone.com — Domain Acquisition Inquiry')}`}
							class="mt-6 inline-block text-sm font-medium text-brass-400 hover:text-brass-300 underline underline-offset-4">Or email us directly</a>
						<br />
						<button type="button" data-reset-form
							class="mt-4 text-sm font-medium text-ink-400 hover:text-white underline underline-offset-4">Submit another inquiry</button>
					</div>
				</div>

				<div class="text-center mt-6 text-xs text-ink-500 flex items-center justify-center gap-x-2">
					<Icon name="lock" class="w-4 h-4" />
					<span>Secure escrow via Escrow.com or preferred provider • Full transparency • Flexible terms available</span>
				</div>
			</div>
		</section>

		<!-- FINAL CTA / FOOTER TEASER -->
		<div class="border-t border-ink-800 bg-ink-900 py-9">
			<div class="max-w-screen-2xl mx-auto px-6 md:px-12 lg:px-16 text-center">
				<p class="text-sm text-ink-400">The mental health innovation economy is being built right now.<br class="hidden sm:block" /> <span class="text-white font-medium">brainlodestone.com</span> is the address for those leading it.</p>
			</div>
		</div>
	</main>
	<Footer />

	<!-- Sticky mobile conversion bar -->
	<div
		id="mobile-cta"
		class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-800 bg-ink-950/95 backdrop-blur-lg transition-transform duration-300 md:hidden"
	>
		<div class="flex items-center gap-4 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
			<div class="min-w-0">
				<div class="text-[10px] font-medium uppercase tracking-[0.15em] text-ink-400">List price</div>
				<div class="font-mono text-lg font-semibold leading-tight text-brass-300">{PRICE.display}</div>
			</div>
			<a
				href="#acquire"
				class="flex-1 rounded-2xl bg-brass-400 px-5 py-3.5 text-center text-sm font-semibold text-ink-950 transition-colors hover:bg-brass-300 active:bg-white"
			>
				Acquire this domain
			</a>
		</div>
	</div>
</BaseLayout>

<script>
	import { INQUIRY_ENDPOINT } from '../lib/site';

	const SPINNER = `<span class="flex items-center justify-center gap-x-2"><svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Sending…</span></span>`;

	function fieldValue(id: string): string {
		return (document.getElementById(id) as HTMLInputElement | null)?.value ?? '';
	}

	function initForm() {
		const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
		const successState = document.getElementById('form-success') as HTMLElement | null;
		const errorState = document.getElementById('form-error') as HTMLElement | null;
		if (!form || !successState) return;

		const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const defaultLabel = submitBtn?.innerHTML ?? '';

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			errorState?.classList.add('hidden');
			if (!submitBtn) return;

			submitBtn.disabled = true;
			submitBtn.innerHTML = SPINNER;

			try {
				const response = await fetch(INQUIRY_ENDPOINT, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({
						name: fieldValue('full-name'),
						email: fieldValue('email'),
						phone: fieldValue('phone'),
						use: fieldValue('intended-use'),
						message: fieldValue('message'),
						website: fieldValue('website'),
					}),
				});
				const data = (await response.json().catch(() => ({}))) as {
					ok?: boolean;
					error?: string;
				};

				if (!response.ok || !data.ok) {
					throw new Error(data.error || 'Something went wrong. Please email us directly.');
				}

				form.classList.add('hidden');
				successState.classList.remove('hidden');
			} catch (error) {
				const message =
					error instanceof Error
						? error.message
						: 'Something went wrong. Please email us directly.';
				if (errorState) {
					errorState.textContent = message;
					errorState.classList.remove('hidden');
				}
				submitBtn.disabled = false;
				submitBtn.innerHTML = defaultLabel;
			}
		});

		document.querySelector('[data-reset-form]')?.addEventListener('click', () => {
			successState.classList.add('hidden');
			form.classList.remove('hidden');
			form.reset();
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.innerHTML = defaultLabel;
			}
		});
	}

	function initSmoothScroll() {
		document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
			anchor.addEventListener('click', function (this: HTMLAnchorElement, e: Event) {
				const href = this.getAttribute('href');
				if (!href || href === '#') return;
				const targetElement = document.getElementById(href.substring(1));
				if (!targetElement) return;
				e.preventDefault();
				const navHeight = 80;
				const offsetPosition =
					targetElement.getBoundingClientRect().top + window.scrollY - navHeight;
				window.scrollTo({ top: offsetPosition, behavior: 'smooth' });
			});
		});
	}

	function initMobileCta() {
		const bar = document.getElementById('mobile-cta');
		const acquire = document.getElementById('acquire');
		if (!bar || !acquire || !('IntersectionObserver' in window)) return;
		const observer = new IntersectionObserver(
			([entry]) => bar.classList.toggle('translate-y-full', entry.isIntersecting),
			{ threshold: 0.12 },
		);
		observer.observe(acquire);
	}

	initForm();
	initSmoothScroll();
	initMobileCta();
</script>
